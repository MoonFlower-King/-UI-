[
  {
    "id": "layout",
    "name": "布局与留白",
    "intro": "页面东西怎么摆。说清楚布局，AI 才不会把所有东西堆成一列。",
    "items": [
      "whitespace",
      "grid-system",
      "bento-grid",
      "hero-section",
      "above-the-fold",
      "split-screen",
      "card-layout",
      "sticky-header",
      "z-pattern",
      "visual-hierarchy",
      "masonry",
      "holy-grail",
      "asymmetrical-grid"
    ]
  },
  {
    "id": "type",
    "name": "字体与文字",
    "intro": "文字占了界面的大部分。“字不好看”往往是这几个参数没调好。",
    "items": [
      "type-scale",
      "font-weight",
      "line-height",
      "letter-spacing",
      "measure",
      "serif-sans",
      "display-font",
      "truncation"
    ]
  },
  {
    "id": "text",
    "name": "文字特效",
    "intro": "标题怎么出场、关键词怎么强调，决定了第一眼的气质。这些词让 AI 做出会“说话”的文字。",
    "items": [
      "typewriter",
      "text-scramble",
      "gradient-text",
      "split-text",
      "highlight-marker",
      "marquee"
    ]
  },
  {
    "id": "color",
    "name": "色彩",
    "intro": "配色难看，通常不是颜色选错，而是颜色太多、没有主次。",
    "items": [
      "accent-color",
      "neutral-palette",
      "60-30-10-rule",
      "contrast",
      "gradient",
      "mesh-gradient",
      "semantic-color",
      "dark-mode",
      "monochrome"
    ]
  },
  {
    "id": "style",
    "name": "视觉风格流派",
    "intro": "一个风格名就能让 AI 把整套界面的感觉对上。想要“某种感觉”时先查这里。",
